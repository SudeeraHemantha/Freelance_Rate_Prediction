# Global Architecture Environment Variable Blueprint

# ==========================================
# 1. FRONTEND (Vercel)
# ==========================================
NEXT_PUBLIC_API_URL=https://freelance-rate-predictor-backend.onrender.com

# ==========================================
# 2. BACKEND (Render)
# ==========================================
ENV=production
DEBUG=false
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:5432/freelance_predictor
REDIS_URL=redis://:<PASSWORD>@<HOST>:<PORT>/0
API_KEY=freelance_sec_prod_key_change_me
JWT_SECRET=freelance_predictor_prod_jwt_secret_change_me
CORS_ORIGINS=https://freelance-rate-predictor.vercel.app,http://localhost:3000
